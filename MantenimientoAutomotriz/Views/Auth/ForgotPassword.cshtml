@{
    ViewData["Title"] = "Recuperar cuenta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="card-title text-center mb-4">Recuperar contraseña</h2>
                    <p class="text-muted">Ingresa tu correo electrónico. Por seguridad, se mostrará la misma respuesta exista o no la cuenta.</p>
                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Correo electrónico</label>
                            <input type="email" id="email" name="email" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Solicitar restablecimiento</button>
                    </form>
                    @if (ViewBag.MensajeSolicitado == true)
                    {
                        @if (ViewBag.ResetUrl != null)
                        {
                            <div class="alert alert-warning mt-3" role="alert">
                                <strong>Simulación de correo (desarrollo):</strong>
                                <a href="@ViewBag.ResetUrl">Restablecer contraseña</a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mt-3" role="alert">
                                Si el correo corresponde a una cuenta activa, recibirás las instrucciones de restablecimiento.
                            </div>
                        }
                    }
                    <div class="text-center mt-3">
                        <a asp-action="Login">Volver al inicio de sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
